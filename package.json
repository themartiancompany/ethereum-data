    "@eslint/js":
      "^10.0.1",
    "globals":
      "^17.3.0",
    "safely-serve":
      "^0.0.10",
    "webpack":
      "^5.102.1",
    "webpack-cli":
      "^6.0.1"
  },
  "dependencies": {
    "crash-js":
      "^0.11.1"
  },
  "type":
    "commonjs",
  "scripts": {
    "build":
      "npm run lint && npm run build-fs-worker && npm run build-lib",
    "build-fs-worker":
      "npx webpack --mode 'production' --config 'fs-worker.webpack.config.cjs' --stats-error-details; cp 'fs-worker.js' 'dist/ethereum-data",
    "build-lib":
      "npx webpack --mode 'production' --config 'webpack.config.cjs' --stats-error-details; cp 'ethereum-data.js' 'dist/ethereum-data'",
    "build":
      "npm run lint && npm run build-lib",
    "publish-npm":
      "npm run build && npm publish --access public",
    "lint":
      "npx eslint .",
    "start":
      "npx safely-serve 'dist/ethereum-data'",
    "test":
      "echo \"Error: no test specified\" && exit 1"
  }
}
