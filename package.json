  "devDependencies": {
    "brace-expansion":
      "^5.0.9",
    "crash-js-webpack":
      "^0.0.62",
    "fast-uri":
      "^4.1.2",
    "eslint":
      "^10.9.0",
    "@eslint/js":
      "^10.0.1",
    "globals":
      "^17.3.0",
    "safely-serve":
      "^0.0.16",
