/* eslint-disable
     no-unused-vars */

const
  _libcrash_module_import =
    await import(
      "crash-js");
const
  _libcrash_module =
    _libcrash_module_import.default;
/* global
     _file_exists */
const
  _file_exists =
    _libcrash_module._file_exists;
/* global
     _json_read */
const
  _json_read =
    _libcrash_module._json_read;
/* global
     _path_join */
const
  _path_join =
    _libcrash_module._path_join;

function
  _data_split_get(
    _chain_id) {
  let
    _data;
  _data =
    [];
  const
    _path =
      _path_join( [
        __dirname,
        "chains",
        `${_chain_id}.json`
      ]);
  if ( _file_exists(
         _path) ) {
    _data =
      _json_read(
        _path);
  }
  return _data;
}

function
  _data_get(
   _chain_id) {
  let
    _data;
  if ( typeof(
         _chain_id) == "undefined" ||
       _chain_id == "" ) {
    _data =
      _data_unified_get();
  }
  else {
    _data =
      _data_split_get(
        _chain_id);
  }
  return _data;
}

function
  _data_unified_get() {
  const
    _path =
      _path_join( [
        __dirname,
        "chains",
        `chains.json`
      ]);
  const
    _data =
      _json_read(
        _path);
  return _data;
}

export {
  _data_get,
  _data_split_get,
  _data_unified_get
};

